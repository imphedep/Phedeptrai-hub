    warn("[PHE HUB] Invalid Premium Key")
    return
end

local function New(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local old = PlayerGui:FindFirstChild("PHE_HUB")
if old then old:Destroy() end

local gui = New("ScreenGui", {
    Name = "PHE_HUB",
    ResetOnSpawn = false,
}, PlayerGui)

local main = New("Frame", {
    Size = UDim2.fromOffset(320, 390),
    Position = UDim2.new(0.5, -160, 0.5, -195),
    BackgroundColor3 = Color3.fromRGB(25, 23, 38),
    BorderSizePixel = 0,
}, gui)

New("UICorner", {
    CornerRadius = UDim.new(0, 12)
}, main)

New("TextLabel", {
